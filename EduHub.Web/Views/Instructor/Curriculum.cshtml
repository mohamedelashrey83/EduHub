@model EduHub.Web.ViewModels.CurriculumBuilderViewModel
@{
    ViewData["Title"] = $"Curriculum Builder - {Model.Course.Title}";
    var course = Model.Course;
}

<div class="container-fluid px-lg-5 py-5" style="max-width: 1100px;">
    <!-- Builder Header -->
    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1">Step 2: Course Builder</span>
                    <span class="badge @(course.Status == EduHub.Core.Enums.CourseStatus.Published ? "bg-success" : "bg-secondary")">@course.Status</span>
                </div>
                <h3 class="fw-bold mb-0">@course.Title</h3>
                <span class="text-muted small">Drag sections and lessons to reorganize curriculum ordering.</span>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" target="_blank" class="btn btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-eye me-1"></i> Preview as Student
                </a>

                @if (course.Status == EduHub.Core.Enums.CourseStatus.Draft || course.Status == EduHub.Core.Enums.CourseStatus.Rejected)
                {
                    <form asp-action="SubmitApproval" asp-route-id="@course.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning rounded-pill px-3 fw-semibold">
                            <i class="bi bi-send-check me-1"></i> Submit for Approval
                        </button>
                    </form>
                    <form asp-action="Publish" asp-route-id="@course.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success rounded-pill px-3 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Publish Now
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Curriculum Container -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0">Curriculum Structure</h5>
        <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addSectionModal">
            <i class="bi bi-plus-lg me-1"></i> Add New Section
        </button>
    </div>

    <!-- Drag & Drop Sortable Sections List -->
    <div id="sectionsList" class="d-flex flex-column gap-3 mb-5">
        @if (!Model.Sections.Any())
        {
            <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white" id="emptyCurriculumMsg">
                <div class="fs-1 text-muted mb-2"><i class="bi bi-list-nested"></i></div>
                <h5 class="fw-bold">No sections created yet</h5>
                <p class="text-muted small mb-3">Click 'Add New Section' above to organize your modules and upload lectures.</p>
            </div>
        }
        else
        {
            @foreach (var sec in Model.Sections.OrderBy(s => s.OrderIndex))
            {
                <div class="card border-0 shadow-sm rounded-4 bg-white section-item" data-section-id="@sec.Id">
                    <div class="card-header bg-light border-0 py-3 px-4 d-flex justify-content-between align-items-center rounded-top-4">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-grip-vertical text-muted fs-5 cursor-grab section-drag-handle" title="Drag to reorder section"></i>
                            <div>
                                <span class="badge bg-secondary me-2">Section</span>
                                <strong class="text-dark section-title">@sec.Title</strong>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-outline-warning text-dark rounded-pill px-3" onclick="openAddQuizModal(@sec.Id, '@Html.Raw(sec.Title)')">
                                <i class="bi bi-question-diamond me-1"></i> Add Quiz
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="openAddLessonModal(@sec.Id, '@Html.Raw(sec.Title)')">
                                <i class="bi bi-plus-circle me-1"></i> Add Lecture
                            </button>
                            <button type="button" class="btn btn-sm btn-light text-danger rounded-pill px-2" onclick="deleteSection(@sec.Id)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <ul class="list-group list-group-flush lessons-container" data-section-id="@sec.Id">
                            @foreach (var lesson in sec.Lessons.OrderBy(l => l.OrderIndex))
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4 lesson-item" data-lesson-id="@lesson.Id">
                                    <div class="d-flex align-items-center gap-3">
                                        <i class="bi bi-grip-vertical text-muted cursor-grab lesson-drag-handle" title="Drag to reorder lecture"></i>
                                        <i class="bi bi-play-circle text-primary"></i>
                                        <span class="small fw-semibold text-dark">@lesson.Title</span>
                                        @if (lesson.IsFreePreview)
                                        {
                                            <span class="badge bg-success-subtle text-success small">Free Preview</span>
                                        }
                                    </div>

                                    <div class="d-flex align-items-center gap-3">
                                        <span class="text-muted small">@lesson.DurationMinutes min</span>
                                        <button type="button" class="btn btn-link text-danger p-0 small" onclick="deleteLesson(@lesson.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </li>
                            }
                        </ul>

                        @if (sec.Quizzes.Any())
                        {
                            <div class="border-top px-4 py-2 bg-light d-flex justify-content-between align-items-center">
                                <span class="small text-muted fw-bold text-uppercase" style="font-size: 0.72rem;">
                                    <i class="bi bi-question-circle me-1 text-warning"></i> Section Checkpoints & Quizzes (@sec.Quizzes.Count)
                                </span>
                            </div>
                            <ul class="list-group list-group-flush quizzes-container">
                                @foreach (var quiz in sec.Quizzes)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4 quiz-item bg-light-subtle" id="quizItem_@quiz.Id">
                                        <div class="d-flex align-items-center gap-3">
                                            <i class="bi bi-question-diamond-fill text-warning fs-5"></i>
                                            <div>
                                                <span class="small fw-bold text-dark">Quiz: @quiz.Title</span>
                                                <div class="text-muted" style="font-size: 0.75rem;">
                                                    @(quiz.Questions.Count) Questions &bull; Passing Score: @(quiz.PassingScorePercentage)%
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            <a asp-controller="Learning" asp-action="Quiz" asp-route-id="@quiz.Id" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-2 text-decoration-none small" title="Preview Quiz">
                                                <i class="bi bi-eye"></i> Preview
                                            </a>
                                            <button type="button" class="btn btn-link text-danger p-0 small ms-2" onclick="deleteQuiz(@quiz.Id)" title="Delete Quiz">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Modal: Add Section -->
<div class="modal fade" id="addSectionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Add Course Section</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label small fw-bold">Section Title *</label>
                    <input type="text" id="sectionTitleInput" class="form-control" placeholder="e.g. Module 1: Architecture Overview" required />
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="submitNewSection()">Add Section</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add Lesson -->
<div class="modal fade" id="addLessonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Add Lecture to <span id="targetSectionLabel" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="lessonUploadForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" id="lessonSectionId" name="sectionId" />
                    <input type="hidden" name="courseId" value="@course.Id" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Lecture Title *</label>
                        <input type="text" name="title" id="lessonTitleInput" class="form-control" placeholder="e.g. Repository & Unit of Work Pattern" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Duration (Minutes)</label>
                            <input type="number" name="durationMinutes" id="lessonDurationInput" class="form-control" value="10" min="1" required />
                        </div>
                        <div class="col-md-6 d-flex align-items-center pt-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="isFreePreview" id="isFreePreviewCheck" value="true">
                                <label class="form-check-label small fw-semibold" for="isFreePreviewCheck">Enable Free Preview (Anyone can watch)</label>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <h6 class="fw-bold small mb-2"><i class="bi bi-camera-video text-primary me-1"></i> Video Source</h6>
                        <div class="mb-2">
                            <label class="form-label small text-muted">Upload MP4 / WebM Video File to Server:</label>
                            <input type="file" name="videoFile" id="videoFileInput" class="form-control" accept="video/*" />
                        </div>
                        <div class="text-center small text-muted my-1">OR</div>
                        <div>
                            <label class="form-label small text-muted">Direct Streaming URL:</label>
                            <input type="url" name="videoUrl" id="videoUrlInput" class="form-control" placeholder="https://..." value="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold">Lecture Notes & Description (Optional)</label>
                        <textarea name="contentNotes" class="form-control" rows="3" placeholder="Additional reference links, architectural code notes..."></textarea>
                    </div>

                    <!-- Upload Progress Box -->
                    <div id="uploadProgressBox" class="d-none mt-3 p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span id="uploadStatusLabel"><i class="bi bi-cloud-arrow-up text-primary me-1"></i> Uploading lecture video...</span>
                            <span id="uploadPercentLabel" class="fw-bold text-primary">0%</span>
                        </div>
                        <div class="progress rounded-pill" style="height: 10px;">
                            <div id="uploadProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%"></div>
                        </div>
                        <small class="text-muted d-block mt-2" style="font-size: 0.75rem;">
                            <i class="bi bi-info-circle me-1"></i> Please wait while the video file is uploading and being saved to server.
                        </small>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" id="btnSaveLesson" class="btn btn-primary rounded-pill px-4" onclick="submitNewLesson()">
                        <i class="bi bi-save me-1"></i> Save Lecture
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Quiz -->
<div class="modal fade" id="addQuizModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Add Quiz to <span id="quizTargetSectionLabel" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="quizSectionId" />

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label class="form-label small fw-bold">Quiz Title *</label>
                        <input type="text" id="quizTitleInput" class="form-control" placeholder="e.g. Module 1 Knowledge Check" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Passing Score (%)</label>
                        <input type="number" id="quizPassingScoreInput" class="form-control" value="70" min="1" max="100" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold">Description / Instructions (Optional)</label>
                    <textarea id="quizDescInput" class="form-control" rows="2" placeholder="Brief instructions for students taking this quiz..."></textarea>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-list-check text-warning me-1"></i> Questions</h6>
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="addQuestionCard()">
                        <i class="bi bi-plus-lg me-1"></i> Add Question
                    </button>
                </div>

                <!-- Dynamic Questions Container -->
                <div id="quizQuestionsContainer" class="d-flex flex-column gap-3 mb-3">
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnSaveQuiz" class="btn btn-warning rounded-pill px-4 fw-bold" onclick="submitNewQuiz()">
                    <i class="bi bi-save me-1"></i> Save Quiz
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const courseId = @course.Id;

        document.addEventListener('DOMContentLoaded', function () {
            initSortable();
        });

        function initSortable() {
            // Sort sections
            const sectionsEl = document.getElementById('sectionsList');
            if (sectionsEl) {
                new Sortable(sectionsEl, {
                    handle: '.section-drag-handle',
                    animation: 150,
                    onEnd: saveCurriculumOrder
                });
            }

            // Sort lessons within sections
            document.querySelectorAll('.lessons-container').forEach(function (container) {
                new Sortable(container, {
                    group: 'lessons',
                    handle: '.lesson-drag-handle',
                    animation: 150,
                    onEnd: saveCurriculumOrder
                });
            });
        }

        async function saveCurriculumOrder() {
            const reorderList = [];
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            document.querySelectorAll('.section-item').forEach(function (secEl, sIdx) {
                const secId = parseInt(secEl.getAttribute('data-section-id'));
                const lessons = [];

                secEl.querySelectorAll('.lesson-item').forEach(function (lesEl, lIdx) {
                    lessons.push({
                        lessonId: parseInt(lesEl.getAttribute('data-lesson-id')),
                        sectionId: secId,
                        orderIndex: lIdx + 1
                    });
                });

                reorderList.push({
                    sectionId: secId,
                    orderIndex: sIdx + 1,
                    lessons: lessons
                });
            });

            try {
                await fetch(`/Instructor/ReorderCurriculum?courseId=${courseId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(reorderList)
                });
            } catch (err) {
                console.error(err);
            }
        }

        async function submitNewSection() {
            const title = document.getElementById('sectionTitleInput').value.trim();
            if (!title) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const payload = {
                courseId: courseId,
                title: title,
                orderIndex: 99
            };

            try {
                const res = await fetch('/Instructor/AddSection', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                }
            } catch (err) {
                console.error(err);
            }
        }

        function openAddLessonModal(sectionId, sectionTitle) {
            document.getElementById('lessonSectionId').value = sectionId;
            document.getElementById('targetSectionLabel').innerText = sectionTitle;
            
            // Reset form and progress state
            const form = document.getElementById('lessonUploadForm');
            form.reset();
            document.getElementById('lessonSectionId').value = sectionId;
            document.getElementById('videoUrlInput').value = 'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4';
            
            const progressBox = document.getElementById('uploadProgressBox');
            if (progressBox) progressBox.classList.add('d-none');
            
            const bar = document.getElementById('uploadProgressBar');
            if (bar) bar.style.width = '0%';
            
            const saveBtn = document.getElementById('btnSaveLesson');
            if (saveBtn) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="bi bi-save me-1"></i> Save Lecture';
            }

            const modal = new bootstrap.Modal(document.getElementById('addLessonModal'));
            modal.show();
        }

        function submitNewLesson() {
            const form = document.getElementById('lessonUploadForm');
            const saveBtn = document.getElementById('btnSaveLesson');
            const titleInput = document.getElementById('lessonTitleInput');

            if (!titleInput || !titleInput.value.trim()) {
                alert('Please enter a lecture title.');
                titleInput?.focus();
                return;
            }

            const formData = new FormData(form);
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (token) {
                formData.set('__RequestVerificationToken', token);
            }

            const progressBox = document.getElementById('uploadProgressBox');
            const progressBar = document.getElementById('uploadProgressBar');
            const percentLabel = document.getElementById('uploadPercentLabel');
            const statusLabel = document.getElementById('uploadStatusLabel');

            if (progressBox) progressBox.classList.remove('d-none');
            if (saveBtn) {
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Uploading & Saving...';
            }

            const xhr = new XMLHttpRequest();
            xhr.open('POST', '/Instructor/AddLesson', true);
            if (token) {
                xhr.setRequestHeader('RequestVerificationToken', token);
            }

            // Real-time Upload Progress Tracking
            xhr.upload.onprogress = function (e) {
                if (e.lengthComputable) {
                    const percent = Math.round((e.loaded / e.total) * 100);
                    if (progressBar) progressBar.style.width = percent + '%';
                    if (percentLabel) percentLabel.innerText = percent + '%';
                    if (statusLabel) {
                        if (percent < 100) {
                            statusLabel.innerHTML = '<i class="bi bi-cloud-arrow-up text-primary me-1"></i> Uploading video: ' + percent + '%';
                        } else {
                            statusLabel.innerHTML = '<i class="bi bi-gear-fill text-warning me-1"></i> Video uploaded. Saving lecture record...';
                        }
                    }
                }
            };

            xhr.onload = function () {
                if (xhr.status >= 200 && xhr.status < 300) {
                    try {
                        const data = JSON.parse(xhr.responseText);
                        if (data.success) {
                            if (saveBtn) saveBtn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Saved!';
                            location.reload();
                        } else {
                            alert('Error: ' + (data.message || 'Could not save lecture.'));
                            resetSaveButton();
                        }
                    } catch (e) {
                        alert('Lecture saved successfully.');
                        location.reload();
                    }
                } else {
                    let errMsg = 'Upload failed with status ' + xhr.status;
                    if (xhr.status === 413) {
                        errMsg = 'Video file size exceeds server limit (maximum 1 GB).';
                    } else if (xhr.responseText) {
                        try {
                            const errObj = JSON.parse(xhr.responseText);
                            if (errObj.message) errMsg = errObj.message;
                        } catch (e) {
                            errMsg = xhr.responseText.substring(0, 150);
                        }
                    }
                    alert('Error: ' + errMsg);
                    resetSaveButton();
                }
            };

            xhr.onerror = function () {
                alert('A network error occurred while uploading. Please check your connection and try again.');
                resetSaveButton();
            };

            xhr.send(formData);

            function resetSaveButton() {
                if (saveBtn) {
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = '<i class="bi bi-save me-1"></i> Save Lecture';
                }
                if (progressBox) progressBox.classList.add('d-none');
            }
        }

        async function deleteSection(sectionId) {
            if (!confirm('Are you sure you want to delete this section and all its lessons?')) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const form = new FormData();
            form.append('sectionId', sectionId);

            try {
                const res = await fetch('/Instructor/DeleteSection', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: form
                });
                const data = await res.json();
                if (data.success) location.reload();
            } catch (e) { console.error(e); }
        }

        async function deleteLesson(lessonId) {
            if (!confirm('Are you sure you want to delete this lecture?')) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const form = new FormData();
            form.append('lessonId', lessonId);

            try {
                const res = await fetch('/Instructor/DeleteLesson', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: form
                });
                const data = await res.json();
                if (data.success) location.reload();
            } catch (e) { console.error(e); }
        }

        // ======================= Quiz Management =======================
        let questionCounter = 0;

        function openAddQuizModal(sectionId, sectionTitle) {
            document.getElementById('quizSectionId').value = sectionId;
            document.getElementById('quizTargetSectionLabel').innerText = sectionTitle;
            document.getElementById('quizTitleInput').value = '';
            document.getElementById('quizDescInput').value = '';
            document.getElementById('quizPassingScoreInput').value = 70;
            
            const container = document.getElementById('quizQuestionsContainer');
            container.innerHTML = '';
            questionCounter = 0;
            addQuestionCard();

            const modal = new bootstrap.Modal(document.getElementById('addQuizModal'));
            modal.show();
        }

        function addQuestionCard() {
            questionCounter++;
            const qId = questionCounter;
            const container = document.getElementById('quizQuestionsContainer');

            const card = document.createElement('div');
            card.className = 'card border rounded-3 p-3 bg-light question-card';
            card.id = `qCard_${qId}`;
            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-primary rounded-pill px-3 py-1">Question ${qId}</span>
                    <button type="button" class="btn btn-link text-danger p-0" onclick="removeQuestionCard(${qId})" title="Remove question">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Question Text *</label>
                    <input type="text" class="form-control question-text" placeholder="e.g. Which architectural pattern abstracts database access operations?" required />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Question Type</label>
                        <select class="form-select form-select-sm question-type" onchange="changeQuestionType(this, ${qId})">
                            <option value="0" selected>Multiple Choice (4 options)</option>
                            <option value="1">True / False</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Points</label>
                        <input type="number" class="form-control form-select-sm question-points" value="1" min="1" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Answer Options (Select the correct answer):</label>
                    <div class="answers-container d-flex flex-column gap-2" id="answersContainer_${qId}">
                        <div class="input-group input-group-sm">
                            <div class="input-group-text bg-white">
                                <input class="form-check-input mt-0 answer-radio" type="radio" name="correctAnswer_${qId}" value="0" checked title="Mark as correct answer">
                            </div>
                            <input type="text" class="form-control answer-text" placeholder="Option 1 (e.g. Repository Pattern)" required />
                        </div>
                        <div class="input-group input-group-sm">
                            <div class="input-group-text bg-white">
                                <input class="form-check-input mt-0 answer-radio" type="radio" name="correctAnswer_${qId}" value="1" title="Mark as correct answer">
                            </div>
                            <input type="text" class="form-control answer-text" placeholder="Option 2 (e.g. Factory Pattern)" required />
                        </div>
                        <div class="input-group input-group-sm">
                            <div class="input-group-text bg-white">
                                <input class="form-check-input mt-0 answer-radio" type="radio" name="correctAnswer_${qId}" value="2" title="Mark as correct answer">
                            </div>
                            <input type="text" class="form-control answer-text" placeholder="Option 3 (e.g. Singleton Pattern)" />
                        </div>
                        <div class="input-group input-group-sm">
                            <div class="input-group-text bg-white">
                                <input class="form-check-input mt-0 answer-radio" type="radio" name="correctAnswer_${qId}" value="3" title="Mark as correct answer">
                            </div>
                            <input type="text" class="form-control answer-text" placeholder="Option 4 (e.g. Observer Pattern)" />
                        </div>
                    </div>
                </div>
                <div>
                    <label class="form-label small text-muted">Explanation (shown to students upon submission)</label>
                    <input type="text" class="form-control form-control-sm question-explanation" placeholder="e.g. The Repository Pattern mediates between domain and data mapping layers." />
                </div>
            `;
            container.appendChild(card);
        }

        function removeQuestionCard(qId) {
            const card = document.getElementById(`qCard_${qId}`);
            if (card) card.remove();
        }

        function changeQuestionType(selectEl, qId) {
            const answersContainer = document.getElementById(`answersContainer_${qId}`);
            if (!answersContainer) return;
            const type = selectEl.value; // 0 = MultipleChoice, 1 = TrueFalse

            if (type === "1") {
                answersContainer.innerHTML = `
                    <div class="input-group input-group-sm">
                        <div class="input-group-text bg-white">
                            <input class="form-check-input mt-0 answer-radio" type="radio" name="correctAnswer_${qId}" value="0" checked title="Mark as correct answer">
                        </div>
                        <input type="text" class="form-control answer-text" value="True" readonly />
                    </div>
                    <div class="input-group input-group-sm">
                        <div class="input-group-text bg-white">
                            <input class="form-check-input mt-0 answer-radio" type="radio" name="correctAnswer_${qId}" value="1" title="Mark as correct answer">
                        </div>
                        <input type="text" class="form-control answer-text" value="False" readonly />
                    </div>
                `;
            } else {
                answersContainer.innerHTML = `
                    <div class="input-group input-group-sm">
                        <div class="input-group-text bg-white">
                            <input class="form-check-input mt-0 answer-radio" type="radio" name="correctAnswer_${qId}" value="0" checked title="Mark as correct answer">
                        </div>
                        <input type="text" class="form-control answer-text" placeholder="Option 1" required />
                    </div>
                    <div class="input-group input-group-sm">
                        <div class="input-group-text bg-white">
                            <input class="form-check-input mt-0 answer-radio" type="radio" name="correctAnswer_${qId}" value="1" title="Mark as correct answer">
                        </div>
                        <input type="text" class="form-control answer-text" placeholder="Option 2" required />
                    </div>
                    <div class="input-group input-group-sm">
                        <div class="input-group-text bg-white">
                            <input class="form-check-input mt-0 answer-radio" type="radio" name="correctAnswer_${qId}" value="2" title="Mark as correct answer">
                        </div>
                        <input type="text" class="form-control answer-text" placeholder="Option 3" />
                    </div>
                    <div class="input-group input-group-sm">
                        <div class="input-group-text bg-white">
                            <input class="form-check-input mt-0 answer-radio" type="radio" name="correctAnswer_${qId}" value="3" title="Mark as correct answer">
                        </div>
                        <input type="text" class="form-control answer-text" placeholder="Option 4" />
                    </div>
                `;
            }
        }

        async function submitNewQuiz() {
            const sectionId = parseInt(document.getElementById('quizSectionId').value);
            const title = document.getElementById('quizTitleInput').value.trim();
            const desc = document.getElementById('quizDescInput').value.trim();
            const passingScore = parseInt(document.getElementById('quizPassingScoreInput').value) || 70;

            if (!title) {
                alert('Please enter a Quiz Title.');
                return;
            }

            const questionCards = document.querySelectorAll('.question-card');
            if (questionCards.length === 0) {
                alert('Please add at least one question to the quiz.');
                return;
            }

            const questions = [];
            for (let i = 0; i < questionCards.length; i++) {
                const card = questionCards[i];
                const qText = card.querySelector('.question-text').value.trim();
                if (!qText) {
                    alert(`Question ${i + 1} is missing question text.`);
                    return;
                }

                const qType = parseInt(card.querySelector('.question-type').value);
                const qPoints = parseInt(card.querySelector('.question-points').value) || 1;
                const qExp = card.querySelector('.question-explanation').value.trim();

                const answerInputs = card.querySelectorAll('.answer-text');
                const radioInputs = card.querySelectorAll('.answer-radio');

                const answers = [];
                for (let j = 0; j < answerInputs.length; j++) {
                    const ansText = answerInputs[j].value.trim();
                    if (ansText) {
                        answers.push({
                            answerText: ansText,
                            isCorrect: radioInputs[j].checked
                        });
                    }
                }

                if (answers.length < 2) {
                    alert(`Question ${i + 1} must have at least 2 answer options.`);
                    return;
                }

                if (!answers.some(a => a.isCorrect)) {
                    alert(`Question ${i + 1} must have a correct answer selected.`);
                    return;
                }

                questions.push({
                    questionText: qText,
                    questionType: qType,
                    points: qPoints,
                    explanation: qExp,
                    answers: answers
                });
            }

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const payload = {
                courseId: courseId,
                sectionId: sectionId,
                title: title,
                description: desc,
                passingScorePercentage: passingScore,
                questions: questions
            };

            const saveBtn = document.getElementById('btnSaveQuiz');
            if (saveBtn) {
                saveBtn.disabled = true;
                saveBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving Quiz...';
            }

            try {
                const res = await fetch('/Instructor/AddQuiz', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('Error saving quiz: ' + (data.message || 'Unknown error'));
                    if (saveBtn) {
                        saveBtn.disabled = false;
                        saveBtn.innerHTML = '<i class="bi bi-save me-1"></i> Save Quiz';
                    }
                }
            } catch (err) {
                console.error(err);
                alert('Connection error saving quiz: ' + err.message);
                if (saveBtn) {
                    saveBtn.disabled = false;
                    saveBtn.innerHTML = '<i class="bi bi-save me-1"></i> Save Quiz';
                }
            }
        }

        async function deleteQuiz(quizId) {
            if (!confirm('Are you sure you want to delete this quiz? Student attempts will also be removed.')) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                const res = await fetch(`/Instructor/DeleteQuiz?quizId=${quizId}`, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                const data = await res.json();
                if (data.success) {
                    document.getElementById(`quizItem_${quizId}`)?.remove();
                } else {
                    alert('Error deleting quiz: ' + (data.message || 'Unknown error'));
                }
            } catch (e) {
                console.error(e);
                alert('Failed to delete quiz.');
            }
        }
    </script>
}
