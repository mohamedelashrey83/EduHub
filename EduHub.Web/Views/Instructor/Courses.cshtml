@model IEnumerable<EduHub.Core.Entities.Course>
@{
    ViewData["Title"] = "Manage Courses - Instructor";
}

<div class="container-fluid px-lg-5 py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">My Authored Courses</h2>
            <p class="text-muted small mb-0">Manage course contents, curriculum, approval submissions, and publication status.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Create New Course
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
            <div class="fs-1 text-muted mb-2"><i class="bi bi-book"></i></div>
            <h5 class="fw-bold">No courses created yet</h5>
            <p class="text-muted small mb-3">Start sharing your expertise by creating your first course!</p>
            <div>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4">Create Course</a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Course</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Curriculum</th>
                            <th>Enrolled</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(c.ThumbnailUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=100" : c.ThumbnailUrl)" class="rounded-2" style="width: 60px; height: 38px; object-fit: cover;">
                                        <div>
                                            <div class="fw-bold text-dark">@c.Title</div>
                                            <span class="text-muted small">@c.Level • @c.Language</span>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border">@(c.Category?.Name ?? "General")</span></td>
                                <td class="fw-bold text-dark">$@((c.DiscountPrice ?? c.Price).ToString("F2"))</td>
                                <td>
                                    @if (c.Status == EduHub.Core.Enums.CourseStatus.Published)
                                    {
                                        <span class="badge bg-success">Published</span>
                                    }
                                    else if (c.Status == EduHub.Core.Enums.CourseStatus.PendingApproval)
                                    {
                                        <span class="badge bg-warning text-dark">Pending Review</span>
                                    }
                                    else if (c.Status == EduHub.Core.Enums.CourseStatus.Rejected)
                                    {
                                        <span class="badge bg-danger">Changes Requested</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Draft</span>
                                    }
                                </td>
                                <td>
                                    <span class="small text-muted">@c.Sections.Count sections (@c.Sections.Sum(s => s.Lessons.Count) lectures)</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@(c.Enrollments?.Count ?? 0)</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2 align-items-center">
                                        <a asp-action="Curriculum" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Curriculum Builder">
                                            <i class="bi bi-list-check me-1"></i> Builder
                                        </a>

                                        @if (c.Status == EduHub.Core.Enums.CourseStatus.Draft || c.Status == EduHub.Core.Enums.CourseStatus.Rejected)
                                        {
                                            <form asp-action="SubmitApproval" asp-route-id="@c.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-2" title="Submit for Admin Review">
                                                    <i class="bi bi-send-check"></i> Submit
                                                </button>
                                            </form>
                                            <form asp-action="Publish" asp-route-id="@c.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success rounded-pill px-2" title="Direct Publish">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                        }

                                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-light rounded-pill px-2" title="Edit Course Details">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="DeleteCourse" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this course?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light text-danger rounded-pill px-2" title="Delete Course">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
