@model EduHub.Web.ViewModels.InstructorDashboardViewModel
@{
    ViewData["Title"] = "Instructor Dashboard - EduHub";
    var analytics = Model.Analytics;
}

<div class="container-fluid px-lg-5 py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Instructor Studio</h2>
            <p class="text-muted small mb-0">Welcome back, <strong>@Model.Instructor.FullName</strong>. Here is your teaching performance overview.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Courses" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-collection me-1"></i> Manage Courses
            </a>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Create New Course
            </a>
        </div>
    </div>

    <!-- 4 KPI Metrics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Total Revenue (70%)</span>
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-2">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">$@analytics.TotalEarnings.ToString("N2")</h3>
                <span class="text-success small fw-semibold"><i class="bi bi-arrow-up-right"></i> Direct Stripe Payouts</span>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Total Enrollments</span>
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@analytics.TotalStudents</h3>
                <span class="text-primary small fw-semibold"><i class="bi bi-graph-up"></i> Across all courses</span>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Instructor Rating</span>
                    <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-2">
                        <i class="bi bi-star-fill fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@analytics.AverageRating.ToString("F1")</h3>
                <span class="text-muted small">Average of all reviews</span>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Published Courses</span>
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-2">
                        <i class="bi bi-book-fill fs-4"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-0">@analytics.TotalCourses</h3>
                <span class="text-info small fw-semibold">Active catalog</span>
            </div>
        </div>
    </div>

    <!-- Chart.js Visualization Row -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white h-100">
                <h5 class="fw-bold mb-3">Course Enrollments Breakdown</h5>
                <div style="height: 300px;">
                    <canvas id="instructorEnrollmentsChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white h-100">
                <h5 class="fw-bold mb-3">Earnings per Course</h5>
                <div style="height: 300px;">
                    <canvas id="instructorEarningsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Courses Summary Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">My Active Courses</h5>
            <a asp-action="Courses" class="small fw-semibold text-decoration-none">View all &rarr;</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Course</th>
                        <th>Status</th>
                        <th>Price</th>
                        <th>Enrollments</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Courses)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(c.ThumbnailUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=100" : c.ThumbnailUrl)" class="rounded-2" style="width: 50px; height: 32px; object-fit: cover;">
                                    <div>
                                        <div class="fw-bold text-dark small">@c.Title</div>
                                        <span class="text-muted" style="font-size: 0.75rem;">Created @c.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (c.Status == EduHub.Core.Enums.CourseStatus.Published)
                                {
                                    <span class="badge bg-success">Live & Published</span>
                                }
                                else if (c.Status == EduHub.Core.Enums.CourseStatus.PendingApproval)
                                {
                                    <span class="badge bg-warning text-dark">Pending Review</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                            </td>
                            <td class="fw-bold text-dark">$@((c.DiscountPrice ?? c.Price).ToString("F2"))</td>
                            <td>@(c.Enrollments?.Count ?? 0) students</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Curriculum" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-list-check"></i> Curriculum
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-light rounded-pill px-2">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const courseTitles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(analytics.CourseTitles));
        const enrollments = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(analytics.CourseEnrollments));
        const revenues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(analytics.CourseRevenues));

        // Bar Chart - Enrollments
        new Chart(document.getElementById('instructorEnrollmentsChart'), {
            type: 'bar',
            data: {
                labels: courseTitles,
                datasets: [{
                    label: 'Students Enrolled',
                    data: enrollments,
                    backgroundColor: '#6366f1',
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });

        // Donut Chart - Earnings
        new Chart(document.getElementById('instructorEarningsChart'), {
            type: 'doughnut',
            data: {
                labels: courseTitles,
                datasets: [{
                    data: revenues,
                    backgroundColor: ['#0ea5e9', '#6366f1', '#10b981', '#f59e0b']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    </script>
}
