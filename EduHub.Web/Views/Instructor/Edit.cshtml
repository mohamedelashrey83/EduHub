@model EduHub.Web.ViewModels.EditCourseViewModel
@{
    ViewData["Title"] = $"Edit Course - {Model.Title}";
}

<div class="container py-5" style="max-width: 860px;">
    <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="badge @(Model.Status == EduHub.Core.Enums.CourseStatus.Published ? "bg-success" : "bg-secondary") mb-1">@Model.Status</span>
                <h3 class="fw-bold mb-0">Edit Course Details</h3>
            </div>
            <a asp-action="Courses" class="btn btn-outline-secondary rounded-pill px-3">Back to Courses</a>
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Status" />

            <div class="mb-4">
                <label asp-for="Title" class="form-label fw-bold">Course Title *</label>
                <input asp-for="Title" class="form-control form-control-lg" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Subtitle" class="form-label fw-bold">Subtitle</label>
                <input asp-for="Subtitle" class="form-control" />
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label fw-bold">Category *</label>
                    <select asp-for="CategoryId" class="form-select" required>
                        @foreach (var cat in Model.AvailableCategories.Where(c => c.ParentCategoryId == null))
                        {
                            <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">@cat.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Level" class="form-label fw-bold">Difficulty Level *</label>
                    <select asp-for="Level" class="form-select" asp-items="Html.GetEnumSelectList<EduHub.Core.Enums.CourseLevel>()"></select>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Price" class="form-label fw-bold">Price (USD) *</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" required />
                    </div>
                </div>

                <div class="col-md-6">
                    <label asp-for="DiscountPrice" class="form-label fw-bold">Sale Price (USD)</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="DiscountPrice" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-bold">Description *</label>
                <textarea asp-for="Description" class="form-control" rows="5" required></textarea>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="WhatYouWillLearn" class="form-label fw-bold">What Students Learn</label>
                    <textarea asp-for="WhatYouWillLearn" class="form-control" rows="4"></textarea>
                </div>

                <div class="col-md-6">
                    <label asp-for="Requirements" class="form-label fw-bold">Requirements</label>
                    <textarea asp-for="Requirements" class="form-control" rows="4"></textarea>
                </div>
            </div>

            <!-- Media Uploads -->
            <div class="p-4 rounded-4 bg-light border mb-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-cloud-arrow-up text-primary me-2"></i> Update Media</h5>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Upload New Thumbnail</label>
                        <input asp-for="ThumbnailFile" type="file" class="form-control" accept="image/*" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Thumbnail URL</label>
                        <input asp-for="ThumbnailUrl" type="url" class="form-control" />
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Upload New Promo Video</label>
                        <input asp-for="PromoVideoFile" type="file" class="form-control" accept="video/*" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold">Promo Video URL</label>
                        <input asp-for="PromoVideoUrl" type="url" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Curriculum" asp-route-id="@Model.Id" class="btn btn-outline-primary rounded-pill px-4">
                    <i class="bi bi-list-check me-1"></i> Edit Curriculum
                </a>
                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
