@model IEnumerable<EduHub.Core.Entities.Order>
@{
    ViewData["Title"] = "Sales & Commission Reports - Admin";
    decimal totalRev = ViewBag.TotalRevenue ?? 0m;
    var coupons = ViewBag.Coupons as IEnumerable<EduHub.Core.Entities.Coupon> ?? Enumerable.Empty<EduHub.Core.Entities.Coupon>();
}

<div class="container-fluid px-lg-5 py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Financial & Sales Reports</h2>
            <p class="text-muted small mb-0">Platform transactions, revenue splits (70% instructor / 30% platform), and promotional coupons.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Dashboard
        </a>
    </div>

    <!-- Revenue Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <span class="text-muted small fw-semibold">Gross Platform Sales</span>
                <h3 class="fw-bold text-dark mt-2 mb-0">$@totalRev.ToString("N2")</h3>
                <span class="small text-muted">Total orders processed</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <span class="text-muted small fw-semibold">Platform Fee Share (30%)</span>
                <h3 class="fw-bold text-primary mt-2 mb-0">$@((totalRev * 0.30m).ToString("N2"))</h3>
                <span class="small text-primary">EduHub operating margin</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white">
                <span class="text-muted small fw-semibold">Instructor Payouts (70%)</span>
                <h3 class="fw-bold text-success mt-2 mb-0">$@((totalRev * 0.70m).ToString("N2"))</h3>
                <span class="small text-success">Author creator distribution</span>
            </div>
        </div>
    </div>

    <!-- Coupons Summary Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-5">
        <div class="p-4 border-bottom">
            <h5 class="fw-bold mb-0">Active Promotional Coupons (Strategy Pattern)</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Code</th>
                        <th>Type</th>
                        <th>Discount Value</th>
                        <th>Times Used</th>
                        <th>Expiry</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coupon in coupons)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-primary">@coupon.Code</td>
                            <td>@coupon.DiscountType</td>
                            <td class="fw-bold text-dark">
                                @(coupon.DiscountType == EduHub.Core.Enums.DiscountType.Percentage ? $"{coupon.DiscountValue}% OFF" : $"${coupon.DiscountValue:F2} OFF")
                            </td>
                            <td>@coupon.TimesUsed used</td>
                            <td class="small text-muted">@(coupon.ExpiryDate?.ToString("MMM dd, yyyy") ?? "No Expiry")</td>
                            <td>
                                <span class="badge @(coupon.IsActive ? "bg-success" : "bg-secondary")">
                                    @(coupon.IsActive ? "Active" : "Disabled")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="p-4 border-bottom">
            <h5 class="fw-bold mb-0">All Platform Orders</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Order ID</th>
                        <th>Date</th>
                        <th>Student</th>
                        <th>Subtotal</th>
                        <th>Discount</th>
                        <th>Total Paid</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ord in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#ORD-@ord.Id</td>
                            <td class="small text-muted">@ord.OrderDate.ToString("MMM dd, yyyy hh:mm tt")</td>
                            <td class="small">@(ord.Student?.FullName ?? ord.StudentId)</td>
                            <td>$@ord.SubTotal.ToString("F2")</td>
                            <td class="text-success small">-$@ord.DiscountAmount.ToString("F2")</td>
                            <td class="fw-bold text-dark">$@ord.TotalAmount.ToString("F2")</td>
                            <td>
                                <span class="badge bg-success-subtle text-success">@ord.PaymentStatus</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
