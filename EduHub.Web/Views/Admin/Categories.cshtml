@model IEnumerable<EduHub.Core.Entities.Category>
@{
    ViewData["Title"] = "Category Management - Admin";
}

<div class="container-fluid px-lg-5 py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Categories & Topics</h2>
            <p class="text-muted small mb-0">Organize and manage platform taxonomy, icons, and hierarchy.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
            <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
                <i class="bi bi-plus-lg me-1"></i> Create Category
            </button>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var cat in Model.Where(c => c.ParentCategoryId == null))
        {
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm p-4 rounded-4 bg-white h-100">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 fs-3">
                                <i class="bi @cat.IconClass"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold text-dark mb-1">@cat.Name</h5>
                                <span class="badge bg-light text-muted border">@cat.Slug</span>
                            </div>
                        </div>

                        <form asp-action="DeleteCategory" asp-route-id="@cat.Id" method="post" onsubmit="return confirm('Delete this category?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-light text-danger rounded-pill px-2">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>

                    <p class="text-secondary small mb-3">@(cat.Description ?? "Platform course domain category.")</p>

                    <!-- Subcategories -->
                    <div class="border-top pt-3">
                        <span class="small fw-bold text-muted text-uppercase mb-2 d-block">Subcategories:</span>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var sub in cat.Subcategories)
                            {
                                <span class="badge bg-light text-dark border px-3 py-2 small">
                                    <i class="bi @sub.IconClass me-1 text-primary"></i> @sub.Name
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal: Create Category -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Create New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Category Name *</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Mobile Development" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Description</label>
                        <textarea name="description" class="form-control" rows="2" placeholder="Brief summary of topics covered..."></textarea>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Icon Class</label>
                            <input type="text" name="iconClass" class="form-control" value="bi-mortarboard" placeholder="bi-phone, bi-cloud..." />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Parent Category</label>
                            <select name="parentCategoryId" class="form-select">
                                <option value="">None (Top Level)</option>
                                @foreach (var parent in Model.Where(c => c.ParentCategoryId == null))
                                {
                                    <option value="@parent.Id">@parent.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>
