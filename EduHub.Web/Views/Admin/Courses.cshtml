@model IEnumerable<EduHub.Core.Entities.Course>
@{
    ViewData["Title"] = "Course Quality Control - Admin";
}

<div class="container-fluid px-lg-5 py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Course Catalog & Approval Queue</h2>
            <p class="text-muted small mb-0">Review pending curriculum submissions, approve quality courses, or request revisions.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Admin Dashboard
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Course</th>
                        <th>Instructor</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Lectures</th>
                        <th class="text-end pe-4">Quality Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(c.ThumbnailUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=100" : c.ThumbnailUrl)" class="rounded-2" style="width: 60px; height: 38px; object-fit: cover;">
                                    <div>
                                        <div class="fw-bold text-dark">@c.Title</div>
                                        <span class="text-muted small">@c.Level • Submitted @c.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                            </td>
                            <td>@(c.Instructor?.FullName ?? "Instructor")</td>
                            <td>@(c.Category?.Name ?? "General")</td>
                            <td class="fw-bold text-dark">$@((c.DiscountPrice ?? c.Price).ToString("F2"))</td>
                            <td>
                                @if (c.Status == EduHub.Core.Enums.CourseStatus.Published)
                                {
                                    <span class="badge bg-success">Live & Published</span>
                                }
                                else if (c.Status == EduHub.Core.Enums.CourseStatus.PendingApproval)
                                {
                                    <span class="badge bg-warning text-dark">Pending Review</span>
                                }
                                else if (c.Status == EduHub.Core.Enums.CourseStatus.Rejected)
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                            </td>
                            <td>@c.Sections.Sum(s => s.Lessons.Count) lectures</td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a asp-controller="Courses" asp-action="Details" asp-route-id="@c.Id" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-2" title="Inspect Course Page">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (c.Status == EduHub.Core.Enums.CourseStatus.PendingApproval || c.Status == EduHub.Core.Enums.CourseStatus.Draft)
                                    {
                                        <form asp-action="ApproveCourse" asp-route-id="@c.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3">
                                                <i class="bi bi-check-lg me-1"></i> Approve
                                            </button>
                                        </form>

                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#rejectModal_@c.Id">
                                            Reject
                                        </button>

                                        <!-- Reject Feedback Modal -->
                                        <div class="modal fade" id="rejectModal_@c.Id" tabindex="-1" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content border-0 rounded-4 shadow">
                                                    <div class="modal-header border-0">
                                                        <h5 class="modal-title fw-bold">Reject Course & Request Revisions</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <form asp-action="RejectCourse" asp-route-id="@c.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <div class="modal-body text-start">
                                                            <label class="form-label small fw-bold">Feedback / Revision Notes for Instructor:</label>
                                                            <textarea name="reason" class="form-control" rows="3" placeholder="Please clarify module 2 video quality, add missing quiz..."></textarea>
                                                        </div>
                                                        <div class="modal-footer border-0">
                                                            <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger rounded-pill">Confirm Rejection</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
