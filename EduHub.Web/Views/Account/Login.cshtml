@model EduHub.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log In - EduHub";
}

<div class="container py-5" style="max-width: 520px;">
    <!-- Quick Demo Personas Helper Card -->
    <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-4 border-start border-primary border-4">
        <h6 class="fw-bold text-dark mb-1"><i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick One-Click Demo Access</h6>
        <p class="text-muted small mb-3">Select any test role below to sign in instantly without typing credentials:</p>

        <div class="d-flex flex-column gap-2">
            <form asp-action="QuickDemoLogin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="role" value="Student" />
                <button type="submit" class="btn btn-outline-info w-100 text-start py-2 px-3 rounded-3 d-flex justify-content-between align-items-center">
                    <div>
                        <strong class="d-block text-dark small"><i class="bi bi-mortarboard me-1 text-info"></i> Sarah Jenkins (Student)</strong>
                        <span class="text-muted" style="font-size: 0.75rem;">Test learning portal, video player, notes, quiz, certificate</span>
                    </div>
                    <span class="badge bg-info text-dark">One-Click</span>
                </button>
            </form>

            <form asp-action="QuickDemoLogin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="role" value="Instructor" />
                <button type="submit" class="btn btn-outline-warning w-100 text-start py-2 px-3 rounded-3 d-flex justify-content-between align-items-center">
                    <div>
                        <strong class="d-block text-dark small"><i class="bi bi-person-workspace me-1 text-warning"></i> Dr. Alexander Wright (Instructor)</strong>
                        <span class="text-muted" style="font-size: 0.75rem;">Test instructor studio, course creator, curriculum builder</span>
                    </div>
                    <span class="badge bg-warning text-dark">One-Click</span>
                </button>
            </form>

            <form asp-action="QuickDemoLogin" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="role" value="Admin" />
                <button type="submit" class="btn btn-outline-danger w-100 text-start py-2 px-3 rounded-3 d-flex justify-content-between align-items-center">
                    <div>
                        <strong class="d-block text-dark small"><i class="bi bi-shield-lock me-1 text-danger"></i> System Admin</strong>
                        <span class="text-muted" style="font-size: 0.75rem;">Test course approval queue, 4 analytics charts, user management</span>
                    </div>
                    <span class="badge bg-danger">One-Click</span>
                </button>
            </form>
        </div>
    </div>

    <!-- Regular Login Form -->
    <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white">
        <h3 class="fw-bold text-center mb-1">Log in to EduHub</h3>
        <p class="text-muted small text-center mb-4">Enter your email and password to access your account</p>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small py-2 mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-bold">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-bold">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-lock text-muted"></i></span>
                    <input asp-for="Password" class="form-control" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4 small">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label text-muted"></label>
                </div>
                <a href="#" class="text-primary text-decoration-none">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-sm mb-3">
                Log In
            </button>

            <div class="text-center small text-muted">
                Don't have an account?
                <a asp-action="Register" class="text-primary fw-bold text-decoration-none">Sign up</a>
            </div>
        </form>
    </div>
</div>
