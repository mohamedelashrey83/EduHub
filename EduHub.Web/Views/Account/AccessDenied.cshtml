@{
    ViewData["Title"] = "Access Denied - EduHub";
}

<div class="container py-5 text-center" style="max-width: 600px;">
    <div class="card border-0 shadow-sm p-5 rounded-4 bg-white">
        <div class="text-danger fs-1 mb-2">
            <i class="bi bi-shield-lock-fill" style="font-size: 4rem;"></i>
        </div>
        <h3 class="fw-bold text-dark mb-2">Access Denied</h3>
        <p class="text-muted small mb-4">You do not have administrative or instructor permission to access this resource. Please sign in with an authorized account or use the quick persona switcher.</p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Return Home</a>
            <a asp-action="Login" class="btn btn-primary rounded-pill px-4">Log in with another role</a>
        </div>
    </div>
</div>
