@model EduHub.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Sign Up - EduHub";
}

<div class="container py-5" style="max-width: 540px;">
    <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white">
        <h3 class="fw-bold text-center mb-1">Create Your Account</h3>
        <p class="text-muted small text-center mb-4">Start learning or teaching on EduHub today</p>

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small py-2 mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label small fw-bold"></label>
                <input asp-for="FullName" class="form-control" placeholder="Full name" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-bold"></label>
                <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-bold"></label>
                <input asp-for="Password" class="form-control" placeholder="At least 6 characters" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label small fw-bold"></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <!-- Role Selector -->
            <div class="p-3 bg-light rounded-3 border mb-4">
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsInstructor" class="form-check-input" id="instructorSwitch">
                    <label class="form-check-label fw-bold text-dark small" for="instructorSwitch">
                        <i class="bi bi-person-video3 me-1 text-primary"></i> Teach on EduHub (Register as Instructor)
                    </label>
                </div>
                <div class="text-muted" style="font-size: 0.78rem;">
                    Instructors gain access to the course builder, media studio, analytics, and 70% revenue share payouts.
                </div>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold shadow-sm mb-3">
                Create Account
            </button>

            <div class="text-center small text-muted">
                Already have an account?
                <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Log in</a>
            </div>
        </form>
    </div>
</div>
