@model EduHub.Web.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile - EduHub";
}

<div class="container py-5" style="max-width: 760px;">
    <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">Account & Profile Settings</h3>
                <span class="text-muted small">Manage your public bio, social links, and credentials.</span>
            </div>
            <div>
                @foreach (var r in Model.Roles)
                {
                    <span class="badge @(r == "Admin" ? "bg-danger" : (r == "Instructor" ? "bg-warning text-dark" : "bg-primary")) me-1">
                        @r
                    </span>
                }
            </div>
        </div>

        <form asp-action="Profile" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Email" />

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label small fw-bold"></label>
                    <input asp-for="FullName" class="form-control" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Email Address</label>
                    <input type="email" class="form-control" value="@Model.Email" disabled />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Headline" class="form-label small fw-bold"></label>
                <input asp-for="Headline" class="form-control" placeholder="e.g. Senior Software Architect | Microsoft MVP" />
            </div>

            <div class="mb-3">
                <label asp-for="Bio" class="form-label small fw-bold"></label>
                <textarea asp-for="Bio" class="form-control" rows="4" placeholder="Brief background, achievements, and teaching philosophy..."></textarea>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="WebsiteUrl" class="form-label small fw-bold"></label>
                    <input asp-for="WebsiteUrl" class="form-control" placeholder="https://..." />
                </div>
                <div class="col-md-6">
                    <label asp-for="LinkedInUrl" class="form-label small fw-bold"></label>
                    <input asp-for="LinkedInUrl" class="form-control" placeholder="https://linkedin.com/in/..." />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">
                    Save Profile Changes
                </button>
            </div>
        </form>
    </div>
</div>
