@model IEnumerable<EduHub.Core.Entities.Order>
@{
    ViewData["Title"] = "Purchase History - EduHub";
}

<div class="container-fluid px-lg-5 py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Purchase History</h2>
            <p class="text-muted small mb-0">View all your transactions, orders, and itemized receipts.</p>
        </div>
        <a asp-controller="Learning" asp-action="MyCourses" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-collection-play me-1"></i> My Courses
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
            <div class="fs-1 text-muted mb-2"><i class="bi bi-receipt"></i></div>
            <h5 class="fw-bold">No purchase records found</h5>
            <p class="text-muted small">You haven't made any purchases yet.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Order ID</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Payment Method</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#ORD-@order.Id</td>
                                <td class="small text-muted">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="small fw-semibold text-dark">
                                        @string.Join(", ", order.OrderItems.Select(oi => oi.Course?.Title ?? "Course"))
                                    </div>
                                </td>
                                <td class="fw-bold text-dark">$@order.TotalAmount.ToString("F2")</td>
                                <td class="small text-muted">@order.PaymentMethod</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        @order.PaymentStatus
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Success" asp-route-sessionId="@order.StripeSessionId" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                        View Receipt
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
