@model EduHub.Web.ViewModels.CourseDetailsViewModel
@{
    ViewData["Title"] = Model.Course.Title;
    var course = Model.Course;
    var allLessons = course.Sections.SelectMany(s => s.Lessons).ToList();
    int totalDurationMinutes = allLessons.Sum(l => l.DurationMinutes);
    int totalQuizzes = course.Sections.SelectMany(s => s.Quizzes).Count() + course.Quizzes.Count;
}

<!-- Course Header Banner (Dark Navy Theme) -->
<div class="bg-dark text-white py-5 position-relative">
    <div class="container-fluid px-lg-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-8">
                <!-- Category and Level breadcrumb -->
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary px-3 py-1">@(course.Category?.Name ?? "Development")</span>
                    <span class="badge bg-secondary px-2 py-1">@course.Level</span>
                    <span class="text-white-50 small"><i class="bi bi-translate me-1"></i> @course.Language</span>
                </div>

                <h1 class="display-6 fw-bold mb-3 text-white">@course.Title</h1>

                @if (!string.IsNullOrEmpty(course.Subtitle))
                {
                    <p class="lead text-white-50 mb-4">@course.Subtitle</p>
                }

                <div class="d-flex flex-wrap align-items-center gap-4 text-white-50 small mb-3">
                    <div class="d-flex align-items-center gap-1">
                        <span class="fw-bold text-warning fs-6">@Model.ReviewsSummary.AverageRating.ToString("F1")</span>
                        <div class="rating-stars text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Math.Round(Model.ReviewsSummary.AverageRating))
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star"></i>
                                }
                            }
                        </div>
                        <span class="text-white-50">(@Model.ReviewsSummary.TotalReviews ratings)</span>
                    </div>

                    <div>
                        <i class="bi bi-people-fill me-1"></i> @Model.TotalStudentsCount students enrolled
                    </div>

                    <div>
                        <i class="bi bi-person-circle me-1"></i> Created by <span class="text-white fw-semibold">@(course.Instructor?.FullName ?? "Staff Instructor")</span>
                    </div>

                    <div>
                        <i class="bi bi-calendar-event me-1"></i> Last updated @(course.UpdatedAt?.ToString("MMM yyyy") ?? course.CreatedAt.ToString("MMM yyyy"))
                    </div>
                </div>
            </div>

            <!-- Sticky Enrollment Card Column (Desktop) -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white text-dark sticky-top" style="top: 85px; z-index: 10;">
                    <!-- Promo Video Preview / Thumbnail -->
                    <div class="position-relative bg-black" style="padding-top: 56.25%;">
                        <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600" : course.ThumbnailUrl)" alt="@course.Title" class="position-absolute top-0 start-0 w-100 h-100 object-fit-cover opacity-75">
                        
                        @if (!string.IsNullOrEmpty(course.PromoVideoUrl))
                        {
                            <button type="button" class="btn btn-light rounded-circle position-absolute top-50 start-50 translate-middle shadow-lg p-3 d-flex align-items-center justify-content-center" data-bs-toggle="modal" data-bs-target="#previewModal" style="width: 65px; height: 65px;">
                                <i class="bi bi-play-fill fs-2 text-primary ms-1"></i>
                            </button>
                            <span class="position-absolute bottom-0 start-50 translate-middle-x mb-2 badge bg-dark bg-opacity-75 text-white px-2 py-1 small">
                                Preview this course
                            </span>
                        }
                    </div>

                    <div class="card-body p-4">
                        <!-- Pricing Row -->
                        <div class="d-flex align-items-baseline gap-2 mb-3">
                            @if (course.Price == 0 || (course.DiscountPrice.HasValue && course.DiscountPrice.Value == 0))
                            {
                                <span class="display-6 fw-bold text-success">Free</span>
                            }
                            else if (course.DiscountPrice.HasValue && course.DiscountPrice.Value < course.Price)
                            {
                                <span class="display-6 fw-bold text-dark">$@course.DiscountPrice.Value.ToString("F2")</span>
                                <span class="text-muted text-decoration-line-through fs-5">$@course.Price.ToString("F2")</span>
                                <span class="badge bg-danger ms-auto px-2 py-1">@((int)((1 - (course.DiscountPrice.Value / course.Price)) * 100))% OFF</span>
                            }
                            else
                            {
                                <span class="display-6 fw-bold text-dark">$@course.Price.ToString("F2")</span>
                            }
                        </div>

                        <!-- Action Buttons -->
                        @if (Model.IsEnrolled)
                        {
                            <a asp-controller="Learning" asp-action="Watch" asp-route-id="@course.Id" class="btn btn-success btn-lg w-100 py-3 fw-bold rounded-3 mb-2 shadow-sm">
                                <i class="bi bi-play-circle-fill me-2"></i> Go to Classroom
                            </a>
                            <div class="text-center small text-success fw-semibold mb-3">
                                <i class="bi bi-check-circle-fill me-1"></i> You are enrolled in this course
                            </div>
                        }
                        else
                        {
                            @if (course.Price == 0 || (course.DiscountPrice.HasValue && course.DiscountPrice.Value == 0))
                            {
                                <form asp-controller="Checkout" asp-action="FreeEnrollment" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="courseId" value="@course.Id" />
                                    <button type="submit" class="btn btn-success btn-lg w-100 py-3 fw-bold rounded-3 mb-3 shadow-sm">
                                        <i class="bi bi-lightning-charge-fill me-1"></i> Enroll for Free Now
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="mb-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="courseId" value="@course.Id" />
                                    <button type="submit" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-3 shadow-sm">
                                        <i class="bi bi-cart-plus me-2"></i> Add to Cart
                                    </button>
                                </form>
                            }
                        }

                        <p class="text-center text-muted small mb-4">30-Day Money-Back Guarantee</p>

                        <!-- Highlights List -->
                        <div class="border-top pt-3">
                            <h6 class="fw-bold mb-3 small text-uppercase letter-spacing">This course includes:</h6>
                            <ul class="list-unstyled small text-secondary d-flex flex-column gap-2 mb-0">
                                <li><i class="bi bi-camera-video me-2 text-primary"></i> @(totalDurationMinutes / 60) hours @(totalDurationMinutes % 60) mins on-demand video</li>
                                <li><i class="bi bi-journal-text me-2 text-primary"></i> @allLessons.Count lessons & modules</li>
                                <li><i class="bi bi-question-diamond me-2 text-primary"></i> @totalQuizzes practice quizzes & checkpoints</li>
                                <li><i class="bi bi-phone me-2 text-primary"></i> Access on mobile, tablet and desktop</li>
                                <li><i class="bi bi-patch-check me-2 text-success"></i> Verifiable Certificate of Completion</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Main Details Content -->
<div class="container-fluid px-lg-5 py-5">
    <div class="row g-5">
        <div class="col-lg-8">
            <!-- What You'll Learn Box -->
            @if (!string.IsNullOrEmpty(course.WhatYouWillLearn))
            {
                <div class="card border border-primary border-opacity-25 rounded-4 p-4 mb-5 bg-white shadow-sm">
                    <h4 class="fw-bold mb-3"><i class="bi bi-stars text-warning me-2"></i> What you'll learn</h4>
                    <div class="row g-2">
                        @foreach (var point in course.WhatYouWillLearn.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
                        {
                            <div class="col-md-6 d-flex align-items-start gap-2 small text-secondary">
                                <i class="bi bi-check2 text-success fs-5 flex-shrink-0"></i>
                                <span>@point.TrimStart('•', '-', ' ')</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Course Curriculum Accordion -->
            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h4 class="fw-bold mb-1">Course Curriculum</h4>
                        <div class="text-muted small">@course.Sections.Count sections • @allLessons.Count lectures • @(totalDurationMinutes)m total length</div>
                    </div>
                </div>

                <div class="accordion border-0 shadow-sm rounded-4 overflow-hidden" id="curriculumAccordion">
                    @for (int sIndex = 0; sIndex < course.Sections.Count; sIndex++)
                    {
                        var sec = course.Sections.ElementAt(sIndex);
                        string collapseId = $"collapseSec_{sec.Id}";
                        bool isFirst = sIndex == 0;

                        <div class="accordion-item border-start-0 border-end-0 border-top-0">
                            <h2 class="accordion-header" id="heading_@sec.Id">
                                <button class="accordion-button bg-light @(isFirst ? "" : "collapsed") fw-bold py-3" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(isFirst ? "true" : "false")">
                                    <div class="d-flex justify-content-between align-items-center w-100 pe-3">
                                        <span>@sec.Title</span>
                                        <span class="small text-muted fw-normal">@sec.Lessons.Count lectures • @sec.Lessons.Sum(l => l.DurationMinutes)m</span>
                                    </div>
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse @(isFirst ? "show" : "")" data-bs-parent="#curriculumAccordion">
                                <div class="accordion-body p-0">
                                    <ul class="list-group list-group-flush">
                                        @foreach (var lesson in sec.Lessons.OrderBy(l => l.OrderIndex))
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                                                <div class="d-flex align-items-center gap-3">
                                                    <i class="bi bi-play-circle text-muted"></i>
                                                    <span class="small fw-semibold text-dark">@lesson.Title</span>
                                                    @if (lesson.IsFreePreview)
                                                    {
                                                        <span class="badge bg-primary bg-opacity-10 text-primary small">Free Preview</span>
                                                    }
                                                </div>
                                                <div class="d-flex align-items-center gap-3">
                                                    @if (lesson.IsFreePreview && !string.IsNullOrEmpty(lesson.VideoUrl))
                                                    {
                                                        <a href="@lesson.VideoUrl" target="_blank" class="small text-decoration-none fw-semibold">Preview</a>
                                                    }
                                                    <span class="text-muted small">@lesson.DurationMinutes min</span>
                                                </div>
                                            </li>
                                        }

                                        @foreach (var quiz in sec.Quizzes)
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4 bg-light">
                                                <div class="d-flex align-items-center gap-3">
                                                    <i class="bi bi-question-diamond-fill text-warning"></i>
                                                    <span class="small fw-bold text-dark">Checkpoint Quiz: @quiz.Title</span>
                                                </div>
                                                <span class="badge bg-warning bg-opacity-25 text-dark small">Quiz</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Requirements & Description -->
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-5">
                <h4 class="fw-bold mb-3">Requirements</h4>
                <div class="small text-secondary mb-4">
                    @if (!string.IsNullOrEmpty(course.Requirements))
                    {
                        <ul class="mb-0 ps-3">
                            @foreach (var req in course.Requirements.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries))
                            {
                                <li>@req.TrimStart('•', '-', ' ')</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="mb-0">No prior prerequisites required.</p>
                    }
                </div>

                <h4 class="fw-bold mb-3">Description</h4>
                <div class="text-secondary small lh-base">
                    @Html.Raw(course.Description)
                </div>
            </div>

            <!-- Instructor Profile Card -->
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-5">
                <h4 class="fw-bold mb-4">Instructor</h4>
                <div class="d-flex gap-4 align-items-start">
                    <img src="@(string.IsNullOrEmpty(course.Instructor?.AvatarUrl) ? "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150" : course.Instructor.AvatarUrl)" alt="@course.Instructor?.FullName" class="rounded-circle shadow-sm" style="width: 90px; height: 90px; object-fit: cover;">
                    <div>
                        <h5 class="fw-bold mb-1">@(course.Instructor?.FullName ?? "Dr. Alexander Wright")</h5>
                        <div class="text-primary small fw-semibold mb-2">@(course.Instructor?.Headline ?? "Staff Engineer & Cloud Architect")</div>
                        <p class="text-muted small mb-3">@(course.Instructor?.Bio ?? "Industry veteran with 15+ years experience building scalable enterprise distributed systems.")</p>

                        <div class="d-flex gap-3 small text-muted">
                            @if (!string.IsNullOrEmpty(course.Instructor?.WebsiteUrl))
                            {
                                <a href="@course.Instructor.WebsiteUrl" target="_blank" class="text-decoration-none"><i class="bi bi-globe me-1"></i> Website</a>
                            }
                            @if (!string.IsNullOrEmpty(course.Instructor?.LinkedInUrl))
                            {
                                <a href="@course.Instructor.LinkedInUrl" target="_blank" class="text-decoration-none"><i class="bi bi-linkedin me-1"></i> LinkedIn</a>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Student Reviews Section -->
            <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-5">
                <h4 class="fw-bold mb-4">Student Feedback & Reviews</h4>

                <div class="row align-items-center g-4 mb-4">
                    <div class="col-md-4 text-center border-end">
                        <div class="display-4 fw-bold text-dark">@Model.ReviewsSummary.AverageRating.ToString("F1")</div>
                        <div class="rating-stars fs-5 mb-1">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-half"></i>
                        </div>
                        <div class="text-muted small">Course Rating (@Model.ReviewsSummary.TotalReviews reviews)</div>
                    </div>

                    <div class="col-md-8">
                        @for (int star = 5; star >= 1; star--)
                        {
                            int count = Model.ReviewsSummary.RatingDistribution.TryGetValue(star, out var c) ? c : 0;
                            double percent = Model.ReviewsSummary.TotalReviews > 0 ? (count * 100.0 / Model.ReviewsSummary.TotalReviews) : 0;

                            <div class="d-flex align-items-center gap-2 mb-1">
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar bg-warning" role="progressbar" style="width: @percent%"></div>
                                </div>
                                <span class="small text-muted" style="width: 60px;">@star stars</span>
                                <span class="small text-muted text-end" style="width: 40px;">@count</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Submit Review Form (if enrolled) -->
                @if (Model.CanReview)
                {
                    <div class="p-4 rounded-3 bg-light border mb-4">
                        <h6 class="fw-bold mb-3">Leave a Review</h6>
                        <form asp-controller="Reviews" asp-action="Submit" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="courseId" value="@course.Id" />
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Your Rating</label>
                                <select name="rating" class="form-select form-select-sm w-auto">
                                    <option value="5" selected>★★★★★ (5 Stars - Outstanding)</option>
                                    <option value="4">★★★★☆ (4 Stars - Very Good)</option>
                                    <option value="3">★★★☆☆ (3 Stars - Average)</option>
                                    <option value="2">★★☆☆☆ (2 Stars - Below Expectations)</option>
                                    <option value="1">★☆☆☆☆ (1 Star - Poor)</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Feedback</label>
                                <textarea name="comment" class="form-control" rows="3" placeholder="What did you enjoy about this course?" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm px-4">Submit Review</button>
                        </form>
                    </div>
                }

                <!-- Review Items List -->
                <div class="d-flex flex-column gap-3">
                    @foreach (var review in Model.ReviewsSummary.Reviews)
                    {
                        <div class="border-bottom pb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-secondary bg-opacity-25 text-dark fw-bold d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        @(review.Student?.FullName?[..1].ToUpper() ?? "S")
                                    </div>
                                    <div>
                                        <div class="fw-bold small text-dark">@(review.Student?.FullName ?? "Student")</div>
                                        <div class="rating-stars" style="font-size: 0.75rem;">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.Rating)
                                                {
                                                    <i class="bi bi-star-fill"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star"></i>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                                <span class="text-muted small">@review.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                            <p class="text-secondary small mt-2 mb-2">@review.Comment</p>

                            <!-- Helpful vote -->
                            <div class="d-flex align-items-center gap-2">
                                <form asp-controller="Reviews" asp-action="VoteHelpful" method="post" class="d-inline" onsubmit="event.preventDefault(); voteHelpful(this, @review.Id);">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-xs btn-outline-secondary py-1 px-2 rounded small" style="font-size: 0.75rem;">
                                        <i class="bi bi-hand-thumbs-up"></i> Helpful (<span id="voteCount_@review.Id">@review.HelpfulVotesCount</span>)
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Promo Video Modal -->
@if (!string.IsNullOrEmpty(course.PromoVideoUrl))
{
    <div class="modal fade" id="previewModal" tabindex="-1" aria-labelledby="previewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-dark text-white border-0 rounded-4 overflow-hidden">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="previewModalLabel">@course.Title - Preview</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="ratio ratio-16x9">
                        <video id="promoPlayer" class="video-js vjs-default-skin vjs-big-play-centered" controls preload="auto">
                            <source src="@course.PromoVideoUrl" type="video/mp4">
                        </video>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        async function voteHelpful(form, reviewId) {
            const formData = new FormData(form);
            formData.append('reviewId', reviewId);

            try {
                const response = await fetch('/Reviews/VoteHelpful', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                if (result.success) {
                    document.getElementById(`voteCount_${reviewId}`).innerText = result.helpfulCount;
                }
            } catch (err) {
                console.error(err);
            }
        }
    </script>
}
