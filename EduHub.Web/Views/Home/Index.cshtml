@model IEnumerable<EduHub.Core.Entities.Course>
@{
    ViewData["Title"] = "EduHub - Learn Without Limits";
    var categories = ViewBag.Categories as IEnumerable<EduHub.Core.Entities.Category> ?? Enumerable.Empty<EduHub.Core.Entities.Category>();
    int totalCourses = ViewBag.TotalCourses ?? 0;
    int totalEnrollments = ViewBag.TotalEnrollments ?? 0;
    var instructors = ViewBag.TopInstructors as IEnumerable<EduHub.Core.Entities.ApplicationUser> ?? Enumerable.Empty<EduHub.Core.Entities.ApplicationUser>();
}

<!-- Hero Section -->
<section class="py-5 bg-white border-bottom position-relative overflow-hidden">
    <div class="container-fluid px-lg-5 py-4">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="badge bg-primary bg-opacity-10 text-primary mb-3 px-3 py-2 fw-semibold rounded-pill" style="font-size: 0.85rem;">
                    <i class="bi bi-stars me-1 text-warning"></i> Modern Enterprise E-Learning Platform
                </span>
                <h1 class="display-4 fw-extrabold text-dark mb-3 lh-tight" style="font-weight: 800;">
                    Learn from Industry Leaders. <br>
                    <span class="text-primary">Master Real-World Engineering.</span>
                </h1>
                <p class="lead text-secondary mb-4" style="max-width: 600px;">
                    EduHub brings enterprise architectures, cloud systems, and software engineering into interactive video classrooms. Track your progress, pass hands-on quizzes, and earn verifiable certificates.
                </p>

                <div class="d-flex flex-wrap gap-3 mb-5">
                    <a asp-controller="Courses" asp-action="Index" class="btn btn-primary btn-lg px-4 py-3 shadow-sm">
                        <i class="bi bi-compass me-2"></i> Explore Courses
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg px-4 py-3">
                        <i class="bi bi-person-workspace me-2"></i> Teach on EduHub
                    </a>
                </div>

                <!-- Live Metrics -->
                <div class="row g-3 pt-3 border-top">
                    <div class="col-4">
                        <h4 class="fw-bold text-dark mb-0">@(totalCourses + 20)+</h4>
                        <span class="text-muted small">Curated Courses</span>
                    </div>
                    <div class="col-4">
                        <h4 class="fw-bold text-dark mb-0">@(totalEnrollments + 1500)+</h4>
                        <span class="text-muted small">Active Students</span>
                    </div>
                    <div class="col-4">
                        <h4 class="fw-bold text-dark mb-0">99.4%</h4>
                        <span class="text-muted small">Satisfaction Rate</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="position-relative">
                    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                        <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?w=800" alt="Students Learning" class="img-fluid">
                        <div class="card-body p-4 bg-white">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1 rounded">
                                    <i class="bi bi-patch-check-fill me-1"></i> Verified Certification
                                </span>
                                <span class="text-warning small"><i class="bi bi-star-fill"></i> 4.9 (1,240 reviews)</span>
                            </div>
                            <h6 class="fw-bold mb-1">Automated PDF Certificates with iTextSharp</h6>
                            <p class="text-muted small mb-0">Share your achievements directly to LinkedIn with unique verification codes.</p>
                        </div>
                    </div>

                    <!-- Floating Card (Positioned over image top-left to avoid obscuring card text below) -->
                    <div class="card position-absolute top-0 start-0 ms-n3 mt-4 border-0 shadow-lg p-3 rounded-4 bg-white d-none d-sm-flex flex-row align-items-center gap-3" style="max-width: 280px; z-index: 5;">
                        <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-play-circle-fill fs-3"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark small">Video.js Player</div>
                            <div class="text-muted" style="font-size: 0.75rem;">Adaptive streaming, speed controls & notes</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Popular Categories -->
<section class="py-5">
    <div class="container-fluid px-lg-5">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-primary fw-semibold small text-uppercase letter-spacing">Browse Categories</span>
                <h3 class="fw-bold mb-0">Explore Top Domains</h3>
            </div>
            <a asp-controller="Courses" asp-action="Index" class="text-decoration-none fw-semibold">
                View all categories <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var cat in categories)
            {
                <div class="col-lg-3 col-md-6">
                    <a asp-controller="Courses" asp-action="Index" asp-route-categoryId="@cat.Id" class="text-decoration-none">
                        <div class="card h-100 border-0 shadow-sm p-4 rounded-4 hover-lift" style="transition: all 0.2s ease; background: #ffffff;">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                                    <i class="bi @cat.IconClass"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">@cat.Name</h6>
                                    <span class="text-muted small">Explore topics &rarr;</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Courses Grid -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container-fluid px-lg-5">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-primary fw-semibold small text-uppercase letter-spacing">Hand-picked by Experts</span>
                <h3 class="fw-bold mb-0">Featured Courses</h3>
            </div>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-primary btn-sm px-3">
                See all courses
            </a>
        </div>

        <div class="row g-4">
            @{
                var enrolledHomeIds = ViewBag.EnrolledCourseIds as HashSet<int> ?? new HashSet<int>();
            }
            @foreach (var course in Model)
            {
                bool isEnrolled = enrolledHomeIds.Contains(course.Id);
                <div class="col-xl-3 col-lg-4 col-md-6">
                    <div class="course-card">
                        <div class="course-thumbnail-wrapper">
                            <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600" : course.ThumbnailUrl)" alt="@course.Title" loading="lazy">
                            <span class="course-badge-level">@course.Level</span>
                            @if (isEnrolled)
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-2 px-2 py-1 shadow-sm">
                                    <i class="bi bi-check-circle-fill me-1"></i> Subscribed
                                </span>
                            }
                            else if (course.Price == 0 || (course.DiscountPrice.HasValue && course.DiscountPrice.Value == 0))
                            {
                                <span class="badge badge-free position-absolute top-0 end-0 m-2 px-2 py-1">FREE</span>
                            }
                        </div>
                        <div class="p-3 d-flex flex-column flex-grow-1">
                            <div class="text-muted small mb-1">@(course.Category?.Name ?? "General")</div>
                            <h6 class="fw-bold text-dark mb-1 line-clamp-2" style="min-height: 40px;">
                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.Id" class="text-dark text-decoration-none">
                                    @course.Title
                                </a>
                            </h6>
                            <div class="small text-muted mb-2">By @(course.Instructor?.FullName ?? "Staff Educator")</div>

                            <!-- Rating -->
                            <div class="d-flex align-items-center gap-1 mb-3">
                                <span class="fw-bold text-dark small">4.9</span>
                                <div class="rating-stars">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-half"></i>
                                </div>
                                <span class="text-muted small">(@(course.Reviews?.Count > 0 ? course.Reviews.Count : 42))</span>
                            </div>

                            <!-- Price and Action -->
                            <div class="mt-auto pt-2 border-top d-flex justify-content-between align-items-center">
                                <div>
                                    @if (isEnrolled)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i> Subscribed
                                        </span>
                                    }
                                    else if (course.Price == 0 || (course.DiscountPrice.HasValue && course.DiscountPrice.Value == 0))
                                    {
                                        <span class="fw-bold text-success fs-5">Free</span>
                                    }
                                    else if (course.DiscountPrice.HasValue && course.DiscountPrice.Value < course.Price)
                                    {
                                        <span class="fw-bold text-dark fs-5">$@course.DiscountPrice.Value.ToString("F2")</span>
                                        <span class="text-muted text-decoration-line-through small ms-1">$@course.Price.ToString("F2")</span>
                                    }
                                    else
                                    {
                                        <span class="fw-bold text-dark fs-5">$@course.Price.ToString("F2")</span>
                                    }
                                </div>

                                @if (isEnrolled)
                                {
                                    <a asp-controller="Learning" asp-action="Watch" asp-route-id="@course.Id" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold shadow-sm" title="Go to Course">
                                        <i class="bi bi-play-circle-fill me-1"></i> Subscribed
                                    </a>
                                }
                                else
                                {
                                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="courseId" value="@course.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Add to Cart">
                                            <i class="bi bi-cart-plus me-1"></i> Add
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Enterprise Architectural Showcase -->
<section class="py-5 bg-light">
    <div class="container-fluid px-lg-5">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold mb-2">Software Architecture</span>
            <h2 class="fw-bold">Engineered with Production-Grade Patterns</h2>
            <p class="text-muted">EduHub is built upon solid architectural foundations and clean design principles.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm p-4 rounded-4 bg-white">
                    <div class="text-primary fs-2 mb-3"><i class="bi bi-layers-fill"></i></div>
                    <h5 class="fw-bold">N-Tier Architecture</h5>
                    <p class="text-muted small mb-0">Strict separation between Presentation (EduHub.Web), Business Logic (EduHub.Services), and Data Access (EduHub.Data).</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm p-4 rounded-4 bg-white">
                    <div class="text-primary fs-2 mb-3"><i class="bi bi-database-fill-gear"></i></div>
                    <h5 class="fw-bold">Repository & Unit of Work</h5>
                    <p class="text-muted small mb-0">Complete abstraction of database operations and atomic multi-entity transaction control with EF Core 10.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm p-4 rounded-4 bg-white">
                    <div class="text-primary fs-2 mb-3"><i class="bi bi-tags-fill"></i></div>
                    <h5 class="fw-bold">Strategy Pattern</h5>
                    <p class="text-muted small mb-0">Dynamic pricing evaluation supporting coupons, volume bundle discounts, free tiers, and seasonal promotions.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm p-4 rounded-4 bg-white">
                    <div class="text-primary fs-2 mb-3"><i class="bi bi-bell-fill"></i></div>
                    <h5 class="fw-bold">Observer Pattern</h5>
                    <p class="text-muted small mb-0">Reactive event tracking for student progress, automatically triggering certificate generation and notifications upon 100% completion.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<section class="py-5 bg-dark text-white text-center position-relative overflow-hidden">
    <div class="container py-4 position-relative" style="z-index: 1;">
        <h2 class="display-5 fw-bold mb-3">Ready to Accelerate Your Career?</h2>
        <p class="lead text-white-50 mb-4" style="max-width: 600px; margin: 0 auto;">
            Join thousands of developers building scalable systems. Learn at your own pace and earn industry-recognized certificates.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Courses" asp-action="Index" class="btn btn-primary btn-lg px-4 py-3">
                Start Learning Now
            </a>
            <a asp-controller="Certificate" asp-action="Verify" class="btn btn-outline-light btn-lg px-4 py-3">
                Verify a Certificate
            </a>
        </div>
    </div>
</section>
