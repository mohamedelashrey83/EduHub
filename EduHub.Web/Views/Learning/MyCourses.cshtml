@model IEnumerable<EduHub.Core.Entities.Enrollment>
@{
    ViewData["Title"] = "My Learning - EduHub";
    var inProgress = Model.Where(e => !e.IsCompleted && e.ProgressPercentage < 100).ToList();
    var completed = Model.Where(e => e.IsCompleted || e.ProgressPercentage >= 100).ToList();
}

<div class="container-fluid px-lg-5 py-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">My Learning Dashboard</h2>
            <p class="text-muted small mb-0">Track your progress, resume lectures, and view earned certificates.</p>
        </div>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-compass me-1"></i> Browse More Courses
        </a>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-pills mb-4" id="pills-tab" role="tablist">
        <li class="nav-item">
            <button class="nav-link active rounded-pill px-4" id="in-progress-tab" data-bs-toggle="pill" data-bs-target="#in-progress" type="button">
                In Progress (@inProgress.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4" id="completed-tab" data-bs-toggle="pill" data-bs-target="#completed" type="button">
                Completed Courses (@completed.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="pills-tabContent">
        <!-- Tab 1: In Progress -->
        <div class="tab-pane fade show active" id="in-progress" role="tabpanel">
            @if (!inProgress.Any())
            {
                <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                    <div class="fs-1 text-muted mb-2"><i class="bi bi-journal-check"></i></div>
                    <h5 class="fw-bold">No courses currently in progress</h5>
                    <p class="text-muted small">Explore our catalog and start learning today!</p>
                    <div>
                        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary rounded-pill px-4">Browse Catalog</a>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in inProgress)
                    {
                        var course = item.Course!;
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="course-card">
                                <div class="course-thumbnail-wrapper">
                                    <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600" : course.ThumbnailUrl)" alt="@course.Title">
                                    <span class="course-badge-level">@course.Level</span>
                                </div>
                                <div class="p-3 d-flex flex-column flex-grow-1">
                                    <h6 class="fw-bold text-dark mb-1 line-clamp-2">
                                        <a asp-action="Watch" asp-route-id="@course.Id" class="text-dark text-decoration-none">
                                            @course.Title
                                        </a>
                                    </h6>
                                    <div class="small text-muted mb-3">By @(course.Instructor?.FullName ?? "Instructor")</div>

                                    <!-- Progress bar -->
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between text-muted small mb-1">
                                            <span>Progress</span>
                                            <span class="fw-bold text-dark">@item.ProgressPercentage.ToString("F0")%</span>
                                        </div>
                                        <div class="progress mb-3" style="height: 6px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @item.ProgressPercentage%"></div>
                                        </div>

                                        <a asp-action="Watch" asp-route-id="@course.Id" class="btn btn-primary btn-sm w-100 rounded-pill py-2">
                                            <i class="bi bi-play-fill me-1"></i> Continue Lecture
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Tab 2: Completed -->
        <div class="tab-pane fade" id="completed" role="tabpanel">
            @if (!completed.Any())
            {
                <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
                    <div class="fs-1 text-muted mb-2"><i class="bi bi-award"></i></div>
                    <h5 class="fw-bold">No completed courses yet</h5>
                    <p class="text-muted small">Complete 100% of lectures in any course to earn your verified certificate!</p>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var item in completed)
                    {
                        var course = item.Course!;
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="course-card border-success">
                                <div class="course-thumbnail-wrapper">
                                    <img src="@(string.IsNullOrEmpty(course.ThumbnailUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600" : course.ThumbnailUrl)" alt="@course.Title">
                                    <span class="badge bg-success position-absolute top-0 end-0 m-2 px-2 py-1">
                                        <i class="bi bi-check2-all"></i> COMPLETED
                                    </span>
                                </div>
                                <div class="p-3 d-flex flex-column flex-grow-1">
                                    <h6 class="fw-bold text-dark mb-1 line-clamp-2">@course.Title</h6>
                                    <div class="small text-muted mb-3">Completed on @(item.CompletedAt?.ToString("MMM dd, yyyy") ?? "Recent")</div>

                                    <div class="mt-auto d-flex flex-column gap-2">
                                        <a asp-controller="Certificate" asp-action="ViewByEnrollment" asp-route-enrollmentId="@item.Id" class="btn btn-warning btn-sm w-100 rounded-pill py-2 fw-bold text-dark shadow-sm">
                                            <i class="bi bi-award-fill me-1"></i> View Certificate
                                        </a>
                                        <a asp-action="Watch" asp-route-id="@course.Id" class="btn btn-outline-secondary btn-sm w-100 rounded-pill py-2">
                                            Rewatch Lectures
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
